{
  "name": "frontend",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --public",
    "generate:api-types": "npm --prefix ../backend run generate:openapi && openapi-typescript ../backend/openapi.json -o ./app/shared/types/api.generated.ts && node ./scripts/append-openapi-aliases.mjs",
    "generate:cms-api-types": "openapi-typescript ../cms/openapi.json -o ./app/core/cms/types/api.generated.ts && node ./scripts/append-cms-openapi-aliases.mjs",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "type-check": "nuxi typecheck",
    "precommit": "npm run generate:api-types && npm run type-check && npm run test && npm run format:fix && npm run lint:fix",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@microsoft/clarity": "^1.0.2",
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/image": "^2.0.0",
    "@nuxt/ui": "^4.7.1",
    "@pinia/nuxt": "^1.0.1",
    "@vueuse/core": "^14.3.0",
    "ioredis": "^5.11.1",
    "nuxt": "^4.4.2",
    "pinia": "^4.0.2",
    "tailwindcss": "^4.2.2",
    "vue": "^3.5.30",
    "vue-i18n": "^11.4.13",
    "vue-router": "^5.0.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/css": "^1.2.0",
    "@iconify-json/lucide": "^1.2.98",
    "@vue/language-core": "^3.1.1",
    "eslint": "^9.39.4",
    "eslint-plugin-better-tailwindcss": "^4.4.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.3",
    "sass": "^1.98.0",
    "tailwind-csstree": "^0.3.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.2.7"
  }
}
