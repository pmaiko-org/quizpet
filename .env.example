# Compose project
COMPOSE_PROJECT_NAME=quizpet
PROJECT_PREFIX=p-quizpet

# Frontend
FRONTEND_PORT=5001
NUXT_PUBLIC_CMS_API_URL=/api/cms
NUXT_REVALIDATE_SECRET=replace-with-random-value

# Backend
BACKEND_PORT=5002

# rclone storage (Google Drive)
RCLONE_STORAGE_REMOTE=gdrive:
RCLONE_VFS_CACHE_MODE=off
RCLONE_CMS_REMOTE=gdrive:cms
RCLONE_CMS_VFS_CACHE_MODE=off

# Google OAuth
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4999/backend/auth/google/redirect

# CMS server
CMS_PORT=1337
CMS_HOST=0.0.0.0
CMS_PUBLIC_URL=/cms
CMS_IS_PROXIED=true

# CMS database
CMS_DATABASE_CLIENT=postgres
CMS_DATABASE_NAME=cms
CMS_DATABASE_SCHEMA=public
CMS_DATABASE_SSL=false
CMS_DATABASE_SSL_REJECT_UNAUTHORIZED=true

# CMS secrets
CMS_APP_KEYS=replace-with-four-comma-separated-random-values
CMS_API_TOKEN_SALT=replace-with-random-value
CMS_ADMIN_JWT_SECRET=replace-with-random-value
CMS_JWT_SECRET=replace-with-random-value
CMS_TRANSFER_TOKEN_SALT=replace-with-random-value
CMS_ENCRYPTION_KEY=replace-with-random-value

# CMS preview
CMS_PREVIEW_SECRET=replace-with-random-value
CMS_PREVIEW_URL=http://localhost:4999

# PostgreSQL
POSTGRES_PORT=5433
POSTGRES_INTERNAL_PORT=5432
POSTGRES_USER=replace-with-postgres-user
POSTGRES_PASSWORD=replace-with-postgres-password
POSTGRES_DB=db

# Redis
REDIS_PORT=6379
