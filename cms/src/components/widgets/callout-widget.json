        "info",
        "success",
        "warning",
        "error"
      ],
      "default": "info",
      "required": true
    },
    "icon": {
      "type": "string",
      "customField": "global::icon"
    },
    "primaryLink": {
      "type": "component",
      "component": "shared.link"
    },
    "secondaryLink": {
      "type": "component",
      "component": "shared.link"
    }
  }
}
