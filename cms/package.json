{
  "name": "cms",
  "version": "0.1.0",
  "private": true,
  "description": "A Strapi application",
  "scripts": {
    "build": "strapi build",
    "console": "strapi console",
    "deploy": "strapi deploy",
    "dev": "strapi develop",
    "develop": "strapi develop",
    "start": "strapi start",
    "strapi": "strapi",
    "seed": "tsx scripts/seed.ts",
    "generate:types": "strapi ts:generate-types",
    "generate:openapi": "strapi openapi generate --output ./openapi.json",
    "check:translations": "node scripts/check-translations.mjs",
    "check:widgets": "node scripts/check-widgets.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/admin/tsconfig.json",
    "upgrade": "npx @strapi/upgrade latest",
    "upgrade:dry": "npx @strapi/upgrade latest --dry",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
